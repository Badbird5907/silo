{
  "name": "@silo-storage/sdk-react",
  "version": "0.0.0-alpha.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Badbird5907/silo.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsup --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@silo-storage/eslint-config": "0.1.0",
    "@silo-storage/prettier-config": "0.1.0",
    "@silo-storage/tsconfig": "0.1.0",
    "@types/react": "~19.2.3",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "react": "19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "prettier": "@silo-storage/prettier-config",
  "dependencies": {
    "@silo-storage/mime-types": "0.0.0-alpha.0"
  }
}
