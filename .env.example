# Runtime database URL.
# Local dev (docker-compose): use localhost:5432.
# Production serverless (Supabase transaction mode): use the pooler URL on :6543.
POSTGRES_URL="postgresql://dev:devpass@localhost:5432/appdb"

# Optional direct DB URL for migrations/admin jobs.
# Production: set this to Supabase direct :5432 URL.
# Local dev can omit this (defaults to POSTGRES_URL behavior).
# POSTGRES_URL_DIRECT="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# You can generate the secret via 'openssl rand -base64 32'
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET="local-auth-secret-at-least-32-characters"

# Preconfigured GitHub OAuth provider, works out-of-the-box
# @see https://www.better-auth.com/docs/authentication/github
AUTH_GITHUB_ID="local-github-client-id"
AUTH_GITHUB_SECRET="local-github-client-secret"

# Canonical control-plane URL. Alchemy binds this to the Cloudflare Next.js Worker.
APP_URL="http://localhost:3000"
APP_DOMAIN="app.your-domain.com"
DOCS_DOMAIN="docs.your-domain.com"

# Cloudflare Worker URL for file uploads/downloads
WORKER_URL="http://localhost:8787"
WORKER_DOMAIN="ingest.your-domain.com" # public hostname for the Worker

# Use one of these, depending on your framework
SILO_CDN="lvh.me:8787" # public CDN/ingest host used by SDK clients
NEXT_PUBLIC_SILO_CDN="lvh.me:8787" # Next.js public alias for browser/server usage
VITE_SILO_CDN="lvh.me:8787" # Vite public alias for browser/server usage

# Documentation SDK demo. Replace with a real dashboard token in production.
SILO_URL="http://localhost:3000"
SILO_TOKEN="eyJ2IjoxLCJhayI6ImxvY2FsLWFwaS1rZXkiLCJraWQiOiJsb2NhbC1rZXktaWQiLCJlaWQiOiJsb2NhbC1lbnYtaWQiLCJzcyI6ImxvY2FsLXNpZ25pbmctc2VjcmV0Iiwicm0iOiJwIiwicHMiOiJsb2NhbC1wcm9qZWN0In0"

PROJECT_ROUTE_MODE="path" # "subdomain" => {projectSlug}.{WORKER_DOMAIN}, "path" => {WORKER_DOMAIN}/p/{projectSlug} (fixed /p prefix)

# Signing secret for generating signed URLs (generate via 'openssl rand -hex 32')
SIGNING_SECRET="your-secure-random-secret-here"
CALLBACK_SECRET="your-secure-random-secret-here"

# Set false during the production cutover drain window.
UPLOADS_ENABLED="true"
WEBHOOK_DELIVERY_ENABLED="true"
DEV_UPLOAD_SSE_ENABLED="true"

# Deployment-only values should be supplied by CI/your secret manager:
# CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, and ALCHEMY_PASSWORD.
# Set ATTACH_PRODUCTION_DOMAINS=true only during/after the production cutover.

# Do we want to disable organization creation?
NEXT_PUBLIC_DISABLE_ORG_CREATION=false

# Do we want to disable signup?
DISABLE_SIGNUP="false"
