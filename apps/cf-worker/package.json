{
  "name": "@silo-storage/cf-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter @silo-storage/mime-types --filter @silo-storage/shared build",
    "build": "pnpm run build:deps && tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo dist node_modules .wrangler",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@silo-storage/mime-types": "workspace:*",
    "@silo-storage/shared": "workspace:*",
    "file-type": "^21.3.0",
    "hono": "^4.7.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workerd-windows-64": "^1.20260423.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@silo-storage/eslint-config": "workspace:*",
    "@silo-storage/prettier-config": "workspace:*",
    "@silo-storage/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.0.13"
  },
  "prettier": "@silo-storage/prettier-config"
}
