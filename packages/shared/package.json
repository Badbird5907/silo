{
  "name": "@silo-storage/shared",
  "version": "0.0.0-alpha.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapterData": {
      "types": "./dist/adapterData.d.ts",
      "default": "./dist/adapterData.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "default": "./dist/audit.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "default": "./dist/network.js"
    },
    "./signing": {
      "types": "./dist/signing.d.ts",
      "default": "./dist/signing.js"
    },
    "./slug": {
      "types": "./dist/slug.d.ts",
      "default": "./dist/slug.js"
    }
  },
  "autoexport": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Badbird5907/silo.git"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsup --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@silo-storage/eslint-config": "0.1.0",
    "@silo-storage/prettier-config": "0.1.0",
    "@silo-storage/tsconfig": "0.1.0",
    "@types/node": "22.19.2",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "prettier": "@silo-storage/prettier-config"
}
