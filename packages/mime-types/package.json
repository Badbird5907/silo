{
  "name": "@silo-storage/mime-types",
  "private": true,
  "type": "module",
  "autoexport": true,
  "exports": {
    ".": "./src/index.ts",
    "./application": "./src/application.ts",
    "./audio": "./src/audio.ts",
    "./image": "./src/image.ts",
    "./misc": "./src/misc.ts",
    "./text": "./src/text.ts",
    "./video": "./src/video.ts"
  },
  "license": "MIT",
  "scripts": {
