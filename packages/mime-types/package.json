{
  "name": "@silo-storage/mime-types",
  "version": "0.0.0-alpha.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "autoexport": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./application": {
      "types": "./dist/application.d.ts",
      "default": "./dist/application.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "default": "./dist/audio.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./misc": {
      "types": "./dist/misc.d.ts",
      "default": "./dist/misc.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./video": {
      "types": "./dist/video.d.ts",
      "default": "./dist/video.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Badbird5907/silo.git"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsup --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@silo-storage/eslint-config": "0.1.0",
    "@silo-storage/prettier-config": "0.1.0",
    "@silo-storage/tsconfig": "0.1.0",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "prettier": "@silo-storage/prettier-config"
}
