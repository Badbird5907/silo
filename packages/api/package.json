    "@vercel/queue": "^0.1.3",
    "drizzle-orm": "^0.44.7",
    "nanoid": "^5.1.6",
    "superjson": "2.2.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@silo-storage/eslint-config": "workspace:*",
    "@silo-storage/prettier-config": "workspace:*",
    "@silo-storage/tsconfig": "workspace:*",
    "@types/node": "catalog:",
